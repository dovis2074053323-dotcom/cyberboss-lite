#!/bin/bash
# Grants cyberboss a read-only ACL entry on keke's live Claude Code OAuth
# credential file. Fixed target, no arguments, never reads or prints file
# content — only runs setfacl.
#
# Why this exists: keke's own `claude` CLI usage periodically refreshes its
# OAuth token by writing a brand-new .credentials.json (new inode via
# temp-file + rename), not an in-place edit. A fresh inode does not carry
# over any ACL entry set on the previous one, so cyberboss's read grant on
# the file silently disappears every time that refresh happens. This script
# re-applies exactly that one grant, on exactly that one path, and nothing
# else. It is invoked via sudo (cyberboss -> keke) before every Claude Code
# turn cyberboss's runtime makes; see
# /etc/sudoers.d/cyberboss-claude-acl for the exact, single allowed
# invocation and src/adapters/runtime/claudecode/index.js for the caller.
#
# This is a deployed copy of /usr/local/sbin/cyberboss-ensure-claude-credential-acl
# kept in-repo for reproducibility. See docs/credential-acl-install.md for how
# to install it. Do not edit the deployed copy directly — edit here and
# reinstall.
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "cyberboss-ensure-claude-credential-acl: no arguments accepted" >&2
  exit 2
fi

TARGET="/home/keke/.claude/.credentials.json"

if [ -L "$TARGET" ]; then
  echo "cyberboss-ensure-claude-credential-acl: refusing symlink target" >&2
  exit 3
fi

if [ "$(stat -c '%F' -- "$TARGET" 2>/dev/null)" != "regular file" ]; then
  echo "cyberboss-ensure-claude-credential-acl: target is not a regular file" >&2
  exit 3
fi

exec /usr/bin/setfacl -m u:cyberboss:r-- -- "$TARGET"
