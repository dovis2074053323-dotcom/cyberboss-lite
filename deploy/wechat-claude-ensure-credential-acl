#!/bin/bash
# Re-apply the bot's read-only ACL after Claude refreshes the credential inode.
# This helper has one fixed target and accepts no arguments.
set -euo pipefail

if [ "$#" -ne 0 ]; then
  echo "wechat-claude-ensure-credential-acl: no arguments accepted" >&2
  exit 2
fi

TARGET="/home/keke/.claude/.credentials.json"

if [ -L "$TARGET" ]; then
  echo "wechat-claude-ensure-credential-acl: refusing symlink target" >&2
  exit 3
fi

if [ "$(stat -c '%F' -- "$TARGET" 2>/dev/null)" != "regular file" ]; then
  echo "wechat-claude-ensure-credential-acl: target is not a regular file" >&2
  exit 3
fi

exec /usr/bin/setfacl -m u:wechatbot:r-- -- "$TARGET"
