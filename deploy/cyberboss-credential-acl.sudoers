# Lets the `cyberboss` service account restore its own read-only ACL grant on
# keke's live Claude Code OAuth credential file, which keke's own CLI usage
# silently drops every time it rewrites that file on token refresh. Exactly
# one fixed, argument-less script; no interactive password (cyberboss has no
# password to give). See deploy/cyberboss-ensure-claude-credential-acl.
#
# Deployed copy of /etc/sudoers.d/cyberboss-claude-acl, kept in-repo for
# reproducibility. See docs/credential-acl-install.md for how to install it.
cyberboss ALL=(keke) NOPASSWD: /usr/local/sbin/cyberboss-ensure-claude-credential-acl
